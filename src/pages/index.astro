---
const title = 'Entrega — Calendario de tareas';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111827" />
    <title>{title}</title>
  </head>
  <body>
    <main class="app-shell">
      <header class="topbar">
        <div><p class="eyebrow">TU ESPACIO DE ESTUDIO</p><h1>Entrega<span>.</span></h1></div>
        <div class="today" id="todayLabel"></div>
      </header>
      <section class="intro">
        <div><p class="eyebrow">PLANIFICA · ENTREGA · REPITE</p><h2>No se te escapa<br />ninguna entrega.</h2><p class="sub">Organiza las tareas por asignatura y recibe un correo cuando queden 3 días para la fecha límite.</p></div>
        <div class="stat-card"><span class="stat-label">TAREAS PENDIENTES</span><strong id="pendingCount">—</strong><span class="stat-foot">A un paso de tenerlo todo bajo control</span></div>
      </section>
      <section class="auth-panel" id="authPanel">
        <div><h3>Accede a tu calendario</h3><p>Usa tu cuenta para guardar tus tareas de forma privada.</p></div>
        <form id="authForm" class="auth-form">
          <label>Correo electrónico<input id="authEmail" type="email" autocomplete="email" required placeholder="tu@correo.com" /></label>
          <label>Contraseña<input id="authPassword" type="password" autocomplete="current-password" required minlength="6" placeholder="Mínimo 6 caracteres" /></label>
          <div class="actions"><button type="submit" id="loginBtn">Entrar</button><button type="button" class="secondary" id="registerBtn">Crear cuenta</button></div>
          <p class="message" id="authMessage" aria-live="polite"></p>
        </form>
      </section>
      <section id="workspace" hidden>
        <div class="toolbar"><div><h3>Tu calendario</h3><p id="monthLabel">—</p></div><div class="actions"><button class="secondary" id="prevMonth" aria-label="Mes anterior">←</button><button class="secondary" id="todayBtn">Hoy</button><button class="secondary" id="nextMonth" aria-label="Mes siguiente">→</button><button class="secondary" id="logoutBtn">Cerrar sesión</button></div></div>
        <div class="calendar-wrap"><div class="weekdays"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div><div id="calendar" class="calendar" aria-label="Calendario mensual"></div></div>
        <div class="lower-grid">
          <section class="panel"><div class="panel-heading"><div><p class="eyebrow">NUEVA TAREA</p><h3 id="formTitle">Añadir entrega</h3></div></div>
            <form id="taskForm" class="task-form">
              <input type="hidden" id="taskId" />
              <label>Asignatura<input id="subject" required maxlength="100" placeholder="Ej. Análisis forense" /></label>
              <label>Nombre de la tarea<input id="taskName" required maxlength="160" placeholder="Ej. Informe de evidencias" /></label>
              <label>Fecha límite<input id="dueDate" type="date" required /></label>
              <label>Notas (opcional)<textarea id="notes" rows="3" maxlength="1000" placeholder="Enlace, requisitos o recordatorios…"></textarea></label>
              <div class="actions"><button type="submit" id="saveTaskBtn">Guardar tarea</button><button type="button" class="secondary" id="cancelEditBtn" hidden>Cancelar</button></div>
              <p class="message" id="taskMessage" aria-live="polite"></p>
            </form>
          </section>
          <section class="panel"><div class="panel-heading"><div><p class="eyebrow">PRÓXIMAS ENTREGAS</p><h3>Lo que viene</h3></div><select id="taskFilter" aria-label="Filtrar tareas"><option value="pending">Pendientes</option><option value="all">Todas</option><option value="done">Completadas</option></select></div><div id="taskList" class="task-list"></div></section>
        </div>
      </section>
      <footer><span>Entrega. · Tu ayudante de estudio</span><span>Los recordatorios se revisan cada día a las 08:00 UTC.</span></footer>
    </main>
    <script>
      import { createClient } from '@supabase/supabase-js';
      const cfg = {
        supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
        supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      };
      const $ = (id) => document.getElementById(id);
      const supabase = createClient(cfg.supabaseUrl, cfg.supabaseKey);
      let session = null, tasks = [], currentMonth = new Date(), selectedDate = null;
      const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
      const monthFmt = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric' });
      const isoToday = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };
      $('todayLabel').textContent = new Intl.DateTimeFormat('es-ES', { weekday:'long', day:'numeric', month:'long' }).format(new Date());
      $('dueDate').value = isoToday();
      function msg(id, text, error=false) { const el=$(id); el.textContent=text; el.classList.toggle('error', error); }
      function showWorkspace(on) { $('authPanel').hidden=on; $('workspace').hidden=!on; }
      async function loadTasks() {
        const { data, error } = await supabase.from('tasks').select('*').order('due_date', {ascending:true});
        if(error) { msg('taskMessage', 'No se pudieron cargar las tareas: '+error.message, true); return; }
        tasks = data || []; render();
      }
      $('authForm').addEventListener('submit', async e => {
        e.preventDefault(); msg('authMessage','Conectando…');
        const {data,error}=await supabase.auth.signInWithPassword({email:$('authEmail').value.trim(),password:$('authPassword').value});
        if(error) return msg('authMessage',error.message,true);
        session=data.session; await afterLogin();
      });
      $('registerBtn').addEventListener('click', async () => {
        msg('authMessage','Creando cuenta…');
        const {data,error}=await supabase.auth.signUp({email:$('authEmail').value.trim(),password:$('authPassword').value});
        if(error) return msg('authMessage',error.message,true);
        if(!data.session) return msg('authMessage','Cuenta creada. Revisa tu correo para confirmar el registro.');
        session=data.session; await afterLogin();
      });
      $('logoutBtn').addEventListener('click', async()=>{await supabase.auth.signOut();session=null;showWorkspace(false);});
      supabase.auth.onAuthStateChange((_event,s)=>{session=s;if(s) afterLogin();else showWorkspace(false);});
      async function afterLogin(){showWorkspace(true);await loadTasks();}
      function renderCalendar(){
        const year=currentMonth.getFullYear(), month=currentMonth.getMonth();
        $('monthLabel').textContent=monthFmt.format(currentMonth); const first=new Date(year,month,1); const offset=(first.getDay()+6)%7; const days=new Date(year,month+1,0).getDate(); const total=Math.ceil((offset+days)/7)*7;
        const cal=$('calendar'); cal.innerHTML='';
        for(let i=0;i<total;i++){
          const day=i-offset+1; const date=new Date(year,month,day); const valid=day>0&&day<=days; const key=`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
          const cell=document.createElement('button'); cell.type='button'; cell.className='day'+(!valid?' muted':'')+(key===isoToday()?' today-day':'')+(key===selectedDate?' selected':'');
          const num=document.createElement('span');num.className='day-num';num.textContent=date.getDate();cell.append(num);
          const todays=valid?tasks.filter(t=>t.due_date===key):[]; todays.slice(0,2).forEach(t=>{const dot=document.createElement('span');dot.className='event';dot.textContent=t.subject;cell.append(dot);}); if(todays.length>2){const more=document.createElement('small');more.textContent=`+${todays.length-2}`;cell.append(more);}
          cell.disabled=!valid; cell.addEventListener('click',()=>{selectedDate=key;$('dueDate').value=key;renderCalendar();$('taskFilter').value='all';renderList();}); cal.append(cell);
        }
      }
      function renderList(){
        const list=$('taskList');list.innerHTML=''; const filter=$('taskFilter').value;
        const visible=tasks.filter(t=>filter==='all'||(filter==='done'&&t.completed)||(filter==='pending'&&!t.completed)).sort((a,b)=>a.due_date.localeCompare(b.due_date));
        if(!visible.length){const empty=document.createElement('p');empty.className='empty';empty.textContent='No hay tareas en esta vista. ¡Buen trabajo!';list.append(empty);}
        visible.forEach(t=>{
          const item=document.createElement('article');item.className='task-item'+(t.completed?' completed':'');
          const main=document.createElement('div');main.className='task-main'; const subject=document.createElement('span');subject.className='subject';subject.textContent=t.subject;const name=document.createElement('h4');name.textContent=t.title;const date=document.createElement('p');date.className='task-date';date.textContent='Entrega: '+fmt.format(new Date(t.due_date+'T12:00:00'));main.append(subject,name,date);if(t.notes){const note=document.createElement('p');note.className='notes';note.textContent=t.notes;main.append(note);}
          const controls=document.createElement('div');controls.className='task-controls';const done=document.createElement('button');done.className='icon-btn';done.title=t.completed?'Marcar pendiente':'Marcar completada';done.textContent=t.completed?'↶':'✓';done.addEventListener('click',()=>updateTask(t.id,{completed:!t.completed}));const edit=document.createElement('button');edit.className='icon-btn';edit.title='Editar';edit.textContent='✎';edit.addEventListener('click',()=>editTask(t));const del=document.createElement('button');del.className='icon-btn danger';del.title='Eliminar';del.textContent='×';del.addEventListener('click',()=>deleteTask(t.id));controls.append(done,edit,del);item.append(main,controls);list.append(item);
        });
        $('pendingCount').textContent=tasks.filter(t=>!t.completed).length;
      }
      function render(){renderCalendar();renderList();}
      $('prevMonth').addEventListener('click',()=>{currentMonth=new Date(currentMonth.getFullYear(),currentMonth.getMonth()-1,1);renderCalendar();});
      $('nextMonth').addEventListener('click',()=>{currentMonth=new Date(currentMonth.getFullYear(),currentMonth.getMonth()+1,1);renderCalendar();});
      $('todayBtn').addEventListener('click',()=>{currentMonth=new Date();selectedDate=isoToday();renderCalendar();});
      $('taskFilter').addEventListener('change',renderList);
      $('taskForm').addEventListener('submit',async e=>{
        e.preventDefault();if(!session)return;const id=$('taskId').value;const payload={subject:$('subject').value.trim(),title:$('taskName').value.trim(),due_date:$('dueDate').value,notes:$('notes').value.trim()||null};
        if(!payload.due_date)return msg('taskMessage','Indica una fecha límite.',true);msg('taskMessage','Guardando…');
        const query=id?supabase.from('tasks').update(payload).eq('id',id):supabase.from('tasks').insert({...payload,user_id:session.user.id});const {error}=await query;
        if(error)return msg('taskMessage','No se pudo guardar: '+error.message,true);resetForm();msg('taskMessage','Tarea guardada correctamente.');await loadTasks();
      });
      function resetForm(){ $('taskForm').reset();$('taskId').value='';$('dueDate').value=selectedDate||isoToday();$('formTitle').textContent='Añadir entrega';$('saveTaskBtn').textContent='Guardar tarea';$('cancelEditBtn').hidden=true; }
      function editTask(t){$('taskId').value=t.id;$('subject').value=t.subject;$('taskName').value=t.title;$('dueDate').value=t.due_date;$('notes').value=t.notes||'';$('formTitle').textContent='Editar tarea';$('saveTaskBtn').textContent='Guardar cambios';$('cancelEditBtn').hidden=false;window.scrollTo({top:$('taskForm').getBoundingClientRect().top+window.scrollY-30,behavior:'smooth'});}
      $('cancelEditBtn').addEventListener('click',resetForm);
      async function updateTask(id,changes){const {error}=await supabase.from('tasks').update(changes).eq('id',id);if(error)return alert(error.message);await loadTasks();}
      async function deleteTask(id){if(!confirm('¿Eliminar esta tarea?'))return;const {error}=await supabase.from('tasks').delete().eq('id',id);if(error)return alert(error.message);await loadTasks();}
      const {data:{session:existing}}=await supabase.auth.getSession();if(existing){session=existing;await afterLogin();}
    </script>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eef2ff;background:#0b1020;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% 0%,#17234b 0,transparent 35%),#0b1020;min-height:100vh}.app-shell{max-width:1180px;margin:auto;padding:28px 24px 20px}.topbar,.toolbar,.panel-heading,.actions{display:flex;align-items:center;justify-content:space-between;gap:12px}.topbar{margin-bottom:28px}.eyebrow{font-size:.68rem;letter-spacing:.16em;font-weight:800;color:#8e9cff;margin:0 0 8px}.topbar h1{font-size:1.55rem;letter-spacing:-.05em;margin:0}.topbar h1 span{color:#9ba7ff}.today{font-size:.86rem;color:#b9c2de;text-transform:capitalize}.intro{display:grid;grid-template-columns:1fr 230px;align-items:end;gap:24px;padding:34px;border:1px solid #273252;border-radius:24px;background:linear-gradient(120deg,rgba(35,49,93,.82),rgba(17,25,49,.88));margin-bottom:22px}.intro h2{font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.02;letter-spacing:-.065em;margin:0 0 14px}.sub{color:#b8c3e2;max-width:560px;line-height:1.6;margin:0}.stat-card{background:#0c142b;border:1px solid #303d66;padding:20px;border-radius:18px;display:flex;flex-direction:column;gap:8px}.stat-label,.stat-foot{font-size:.72rem;color:#9aa8cb}.stat-card strong{font-size:2.8rem;letter-spacing:-.05em}.auth-panel,.panel{border:1px solid #273252;background:rgba(16,24,47,.9);border-radius:20px;padding:24px}.auth-panel{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start}.auth-panel h3,.panel h3,.toolbar h3{margin:0 0 7px;font-size:1.1rem}.auth-panel p,.toolbar p{color:#9eaccd;margin:0;font-size:.88rem}.auth-form,.task-form{display:grid;gap:14px}label{display:grid;gap:7px;font-size:.8rem;color:#bdc8e4}input,textarea,select{width:100%;border:1px solid #354267;background:#0b1328;color:#f2f5ff;border-radius:10px;padding:12px 13px;font:inherit;outline:none}input:focus,textarea:focus,select:focus{border-color:#9ba7ff;box-shadow:0 0 0 3px #8797ff20}button{border:0;border-radius:10px;padding:11px 15px;background:#a6b0ff;color:#10152c;font:inherit;font-size:.82rem;font-weight:800;cursor:pointer;transition:transform .15s,opacity .15s}button:hover{transform:translateY(-1px)}button:disabled{opacity:.35;cursor:default}.secondary{background:#202b4c;color:#dce3ff;border:1px solid #344166}.message{min-height:18px;color:#a8b6ff;font-size:.82rem;margin:0}.message.error{color:#ff9eaa}.toolbar{margin:28px 0 14px}.toolbar p{text-transform:capitalize}.calendar-wrap{border:1px solid #273252;border-radius:18px;overflow:hidden;background:#10182f}.weekdays,.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.weekdays{background:#141e3a;border-bottom:1px solid #273252}.weekdays span{text-align:center;padding:12px 4px;color:#8e9cbe;font-size:.72rem;font-weight:700}.day{min-height:96px;border-radius:0;border-right:1px solid #222d4b;border-bottom:1px solid #222d4b;background:transparent;color:#e9edff;text-align:left;padding:9px;display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-width:0}.day:nth-child(7n){border-right:0}.day:hover{background:#192445;transform:none}.day.muted{opacity:.28}.day-num{font-size:.8rem}.today-day .day-num{background:#a6b0ff;color:#10152c;border-radius:50%;width:25px;height:25px;display:grid;place-items:center;font-weight:900}.day.selected{box-shadow:inset 0 0 0 2px #a6b0ff}.event{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#2b3761;color:#dce2ff;border-radius:5px;padding:3px 5px;font-size:.65rem;width:100%}.lower-grid{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:18px;margin-top:20px}.panel-heading{margin-bottom:20px;align-items:flex-start}.panel-heading select{width:auto;max-width:140px;padding:9px;font-size:.78rem}.task-list{display:grid;gap:10px}.task-item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px;border:1px solid #2a3656;border-radius:14px;background:#111a33}.task-item.completed{opacity:.58}.task-item.completed h4{text-decoration:line-through}.task-main{min-width:0}.subject{font-size:.68rem;color:#a6b0ff;font-weight:800}.task-item h4{margin:4px 0 5px;font-size:.92rem;overflow-wrap:anywhere}.task-date,.notes{font-size:.76rem;color:#9eaccd;margin:0;line-height:1.5}.task-controls{display:flex;gap:5px;flex-shrink:0}.icon-btn{padding:7px 10px;background:#253153;color:#dce3ff}.icon-btn.danger{color:#ff9eaa}.empty{color:#9eaccd;font-size:.86rem;padding:12px 0}footer{display:flex;justify-content:space-between;gap:12px;color:#7180a4;font-size:.72rem;padding:24px 2px 4px} [hidden]{display:none!important}@media(max-width:760px){.app-shell{padding:18px 12px}.intro{grid-template-columns:1fr;padding:24px}.stat-card{display:grid;grid-template-columns:1fr auto;align-items:center}.stat-label{grid-column:1}.stat-card strong{grid-column:2;grid-row:1/3}.stat-foot{grid-column:1}.auth-panel,.lower-grid{grid-template-columns:1fr}.day{min-height:76px;padding:5px}.event{font-size:.57rem}.toolbar{align-items:flex-start}.toolbar .actions{flex-wrap:wrap;justify-content:flex-end}.toolbar .actions button{padding:9px 10px}.task-item{align-items:flex-start}.task-controls{flex-wrap:wrap}footer{flex-direction:column}.weekdays span{font-size:.65rem}}@media(max-width:420px){.today{max-width:120px;text-align:right}.day{min-height:62px}.event{display:none}.intro h2{font-size:2.5rem}.toolbar{flex-direction:column}.toolbar .actions{justify-content:flex-start}}
    </style>
  </body>
</html>
